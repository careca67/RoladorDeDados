<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoladorDeDados.MainPage">

    <VerticalStackLayout Padding="24" Spacing="24">

        <Label Text="ROLADOR DE&#10;DADOS"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Margin="0,60,0,0" />

        <Grid x:Name="areaDado"
              WidthRequest="140"
              HeightRequest="140"
              HorizontalOptions="Center"
              Margin="0,40,0,0">

            <!-- Imagem usada no dado de 6 lados -->
            <Image x:Name="imgDado"
                   Source="dado6.png"
                   Aspect="AspectFit" />

            <!-- Dado com número, usado nos outros tipos -->
            <Border x:Name="dadoNumero"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#333333"
                    StrokeThickness="4"
                    StrokeShape="RoundRectangle 20">
                <Label x:Name="lblResultado"
                       Text="6"
                       FontSize="56"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <Picker x:Name="pickerLados"
                Title="Quantidade de lados"
                SelectedIndexChanged="OnLadosChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:Int32}">
                    <x:Int32>4</x:Int32>
                    <x:Int32>6</x:Int32>
                    <x:Int32>10</x:Int32>
                    <x:Int32>20</x:Int32>
                    <x:Int32>100</x:Int32>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Button Text="ROLAR O DADO"
                Clicked="OnRolarClicked"
                HorizontalOptions="Center"
                BackgroundColor="#333333"
                TextColor="White"
                Margin="0,20,0,0" />

    </VerticalStackLayout>
</ContentPage>